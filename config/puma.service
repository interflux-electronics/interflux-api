[Unit]
Description=Interflux API
After=network.target

[Service]
Type=simple
User=bot
WorkingDirectory=/var/www/api.interflux.com
Environment=RAILS_ENV=production
Environment=RAILS_LOG_TO_STDOUT=1
Environment=SOLID_QUEUE_IN_PUMA=1
ExecStart=/home/bot/.rbenv/shims/bundle exec puma -C config/puma.rb
Restart=always
KillMode=mixed
TimeoutStopSec=30
StandardOutput=append:/var/log/api.interflux.com/rails-stdout.log
StandardError=append:/var/log/api.interflux.com/rails-stderr.log

[Install]
WantedBy=multi-user.target