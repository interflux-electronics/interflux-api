# Secrets moved to Rails credentials:
#   config/credentials/production.yml.enc
# Template: config/credentials/credentials.template.yml
# Edit with: bin/rails credentials:edit --environment production
#
# Deploy metadata that stays as ENV (not secrets):
# RAILS_ENV=production
# RAILS_MASTER_KEY=   # or ship config/credentials/production.key securely
# RAILS_LOG_TO_STDOUT=true
# RAILS_SERVE_STATIC_FILES=true
# GIT_BRANCH=
# GIT_REVISION=
# BUILD_TIMESTAMP=
